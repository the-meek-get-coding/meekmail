aws_region  = "us-west-1"
domain_name = "meekmail.com"

# Set this to false while you do not control the domain nameservers yet.
# Domainless mode skips Route 53 DNS records, SES receiving, ACM/API custom
# domain validation, and Amplify custom domain association.
enable_domain_resources = false
enable_amplify          = false

# If the registrar is already delegated to an existing Route 53 zone, set:
# create_route53_zone = false
# route53_zone_id     = "Z..."

amplify_repository_url = "https://github.com/your-org/meekmail"
amplify_branch         = "main"

# To enable Amplify Hosting, set enable_amplify=true and provide the token as
# TF_VAR_amplify_access_token in your shell rather than committing it here.
# enable_amplify = true
#
# After the first Amplify apply, set frontend_redirect_url and extra_frontend_urls
# to the Amplify branch URL if you want Cognito admin login to work there before
# the custom domain is ready.
# frontend_redirect_url = "https://main.dxxxxxxxxxxxxx.amplifyapp.com"
# extra_frontend_urls   = ["https://main.dxxxxxxxxxxxxx.amplifyapp.com"]

admin_emails = [
  "you@gmail.com"
]

forwarding_aliases = {
  "bogdan@meekmail.com" = ["bogdan@gmail.com"]
  "friends@meekmail.com" = [
    "bogdan@gmail.com",
    "friend2@gmail.com"
  ]
}
